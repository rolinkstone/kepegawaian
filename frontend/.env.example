# ============================================================
#  FRONTEND - Template environment (AMAN untuk di-commit)
# ------------------------------------------------------------
#  Cara pakai:
#    cp frontend/.env.example frontend/.env
#    lalu isi semua nilai di bawah ini.
#
#  CATATAN:
#   - Variabel NEXT_PUBLIC_* ikut ter-bundle ke JavaScript browser,
#     jadi JANGAN pernah menaruh rahasia di sana.
#   - Nilai NEXT_PUBLIC_* ditanam saat BUILD. Bila diubah, image
#     harus di-build ulang (`docker compose up -d --build`).
# ============================================================

# ---------- Backend API ----------
NEXT_PUBLIC_API_URL=https://api-tambun.example.com/api
BASE_URL=https://api-tambun.example.com/api

# ---------- Keycloak (dipakai NextAuth di server) ----------
KEYCLOAK_ISSUER=https://auth.example.com/realms/master
KEYCLOAK_CLIENT_ID=kepegawaian
KEYCLOAK_CLIENT_SECRET=ganti_client_secret_frontend

# ---------- Keycloak (dipakai browser / publik) ----------
NEXT_PUBLIC_KEYCLOAK_ISSUER=https://auth.example.com/realms/master
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=kepegawaian

# ---------- NextAuth ----------
NEXTAUTH_URL=https://tambun-raya.example.com
NEXTAUTH_URL_INTERNAL=http://localhost:3002
NEXTAUTH_TRUST_HOST=true
# Wajib diisi, >= 32 byte acak. Generate dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=ganti_dengan_random_32_byte_base64

# ---------- Keycloak admin (hanya bila ada script admin) ----------
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=ganti_password_admin_keycloak
