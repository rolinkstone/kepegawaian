# ============================================================================
#  KONFIGURASI APLIKASI KEPEGAWAIAN
# ============================================================================
#  CARA PAKAI DI SERVER:
#
#      cp .env.example .env        # lalu isi semua nilai di bawah
#      chmod 600 .env
#
#  File `.env` sudah otomatis di-ignore git, JADI JANGAN DI-COMMIT.
#  File ini SUMBER TUNGGAL konfigurasi - docker-compose.yml membacanya,
#  jadi tidak perlu lagi mengisi backend/.env atau frontend/.env.
#
#  Cek konfigurasi sebelum jalan:
#      docker compose config
#
#  Generate secret acak:
#      node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ============================================================================


# ----------------------------------------------------------------------------
# 1. DATABASE MySQL  (dipakai backend)
# ----------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=raya
DB_PASSWORD=GANTI_PASSWORD_MYSQL
DB_NAME=kepegawaian


# ----------------------------------------------------------------------------
# 2. DOMAIN APLIKASI
# ----------------------------------------------------------------------------
# Domain publik frontend (yang dibuka user)
FRONTEND_URL=https://tambun-raya.bbpompky.id
# Domain publik backend / API
BACKEND_URL=https://api-tambun.bbpompky.id
# Endpoint API yang dipanggil browser. WAJIB diakhiri /api
NEXT_PUBLIC_API_URL=https://api-tambun.bbpompky.id/api


# ----------------------------------------------------------------------------
# 3. KEYCLOAK - server & realm
# ----------------------------------------------------------------------------
KEYCLOAK_SERVER_URL=https://auth.bbpompky.id
KEYCLOAK_REALM=master
KEYCLOAK_ISSUER=https://auth.bbpompky.id/realms/master
NEXT_PUBLIC_KEYCLOAK_ISSUER=https://auth.bbpompky.id/realms/master

# Akun admin Keycloak (dipakai backend untuk admin API)
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=GANTI_PASSWORD_ADMIN_KEYCLOAK


# ----------------------------------------------------------------------------
# 4. KEYCLOAK - client untuk BACKEND
#    (Keycloak Console -> Clients -> <client backend> -> Credentials)
# ----------------------------------------------------------------------------
BACKEND_KEYCLOAK_CLIENT_ID=nextjs-local
BACKEND_KEYCLOAK_CLIENT_SECRET=GANTI_CLIENT_SECRET_BACKEND


# ----------------------------------------------------------------------------
# 5. KEYCLOAK - client untuk FRONTEND
#    (Keycloak Console -> Clients -> <client frontend> -> Credentials)
#    PENTING: client frontend dan backend berbeda, jangan disamakan.
# ----------------------------------------------------------------------------
FRONTEND_KEYCLOAK_CLIENT_ID=kepegawaian
FRONTEND_KEYCLOAK_CLIENT_SECRET=GANTI_CLIENT_SECRET_FRONTEND
# Client ID ini ikut ter-bundle ke browser, jadi BUKAN rahasia
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=kepegawaian


# ----------------------------------------------------------------------------
# 6. NEXTAUTH  (frontend)
# ----------------------------------------------------------------------------
NEXTAUTH_URL=https://tambun-raya.bbpompky.id
NEXTAUTH_URL_INTERNAL=http://localhost:3002
NEXTAUTH_TRUST_HOST=true
# WAJIB. Kalau diganti, semua user akan logout dan harus login ulang.
NEXTAUTH_SECRET=GANTI_RANDOM_32_BYTE_BASE64


# ----------------------------------------------------------------------------
# 7. SESSION BACKEND
# ----------------------------------------------------------------------------
# WAJIB. Tanpa ini backend memakai nilai default yang tidak aman.
SESSION_SECRET=GANTI_RANDOM_32_BYTE_BASE64


# ----------------------------------------------------------------------------
# 8. PORT DI HOST  (opsional, ada nilai default)
# ----------------------------------------------------------------------------
# Port frontend di mesin host yang di-proxy nginx
FRONTEND_PORT=3002
# Port backend (backend memakai network_mode: host)
BACKEND_PORT=5001


# ----------------------------------------------------------------------------
# 9. LAIN-LAIN  (opsional)
# ----------------------------------------------------------------------------
# 'true' HANYA untuk testing lokal. Di produksi WAJIB 'false'
# karena membuka akses data pegawai tanpa autentikasi.
ALLOW_TESTING_FALLBACK=false
