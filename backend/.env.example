# ============================================================
#  BACKEND - Template environment (AMAN untuk di-commit)
# ------------------------------------------------------------
#  Cara pakai:
#    cp backend/.env.example backend/.env
#    lalu isi semua nilai di bawah ini.
#
#  File ini dibaca oleh Docker Compose (services.backend.env_file)
#  sekaligus oleh dotenv saat `node server.js` dijalankan.
# ============================================================

# ---------- Server ----------
NODE_ENV=production
PORT=5001

# ---------- Database MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ganti_user_db
DB_PASSWORD=ganti_password_db
DB_NAME=kepegawaian

# ---------- Keycloak (admin / service account) ----------
KEYCLOAK_SERVER_URL=https://auth.example.com
KEYCLOAK_REALM=master
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=ganti_password_admin_keycloak

# ---------- Keycloak client milik backend ----------
KEYCLOAK_CLIENT_ID=nextjs-local
KEYCLOAK_CLIENT_SECRET=ganti_client_secret_backend

# ---------- URL aplikasi ----------
FRONTEND_URL=https://tambun-raya.example.com
BACKEND_URL=https://api-tambun.example.com

# ---------- Session & security ----------
# Wajib >= 32 karakter acak. Generate dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=ganti_dengan_random_32_byte_base64

# Set 'true' HANYA untuk testing lokal (membuka fallback tanpa auth)
ALLOW_TESTING_FALLBACK=false
